# Copy to .env.local and fill in values
# Never commit .env.local

VITE_API_BASE_URL=http://localhost:5000

# Cloudflare Turnstile site key. Public by design - the secret key lives only on the API.
# Leave empty to run registration unchallenged; must be set wherever the API has RecaptchaSetting enabled.
VITE_TURNSTILE_SITE_KEY=
